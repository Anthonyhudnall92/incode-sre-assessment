# Copy to terraform.tfvars (gitignored) and fill in.

region = "us-east-1"

# The EKS API is private (reach it with `make tunnel`). Break-glass only:
# eks_public_access = true opens the public endpoint to these CIDRs.
#   curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]
# eks_public_access = true

# Who gets cluster-admin (kubectl) and administers the cluster's KMS key.
#   aws sts get-caller-identity --query Arn --output text
cluster_admins = {
  you = "arn:aws:iam::123456789012:user/your-user"
}

# Optional: HTTPS on the ALB via ACM. Requires a Route 53 hosted zone you own.
# domain_name     = "demo.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Optional: receive CloudWatch alarm notifications.
# alert_email = "you@example.com"
