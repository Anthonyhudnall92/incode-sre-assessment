# Copy to terraform.tfvars (gitignored) and fill in.

# Optional: subdomain to delegate to Route 53 for the app's HTTPS certificate.
# dns_zone_name = "incode.example.com"

# Repository whose workflows may assume the CI roles.
github_repository = "your-user/your-repo"

# If the repository uses immutable OIDC subjects (check with
# `gh api repos/<owner>/<repo>/actions/oidc/customization/sub`), add its IDs:
# github_owner_id      = 12345678
# github_repository_id = 123456789

# Until the repository is public (no GitHub environments on free private repos):
# github_apply_subject = "ref:refs/heads/main"
